<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="qaReportingJ2eePU" transaction-type="JTA">
        <jta-data-source>java:/QaReportingJ2eeDS</jta-data-source>

        <properties>
            <!-- Auto-generates/updates the schema from the JPA entities — the Jakarta EE
                 equivalent of running Laravel's migrations. -->
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
            <!-- Le schéma est géré par les migrations Flyway (db/migration), plus par Hibernate. -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <!-- Le serveur réel (XAMPP) est MariaDB, pas MySQL : MySQLDialect génère
                 CAST(? AS JSON) pour les colonnes @JdbcTypeCode(SqlTypes.JSON) (voir
                 Test.steps), syntaxe que MariaDB rejette. MariaDBDialect génère le bon SQL. -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
